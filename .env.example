# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Desenvolvimento local com SQLite (padrão):
DATABASE_URL="file:./dev.db"

# Produção/Postgres (Neon): use a URL com pooling no runtime.
# DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# URL direta (sem pooling) usada por migrations. Se ausente, usa DATABASE_URL.
# DIRECT_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Gere um segredo forte com: npx @better-auth/cli secret
# Em produção, NÃO use o valor de exemplo abaixo.
BETTER_AUTH_SECRET="dev-secret-troque-antes-de-publicar"
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Login social (opcional)
# O provedor só é habilitado quando ID e secret estão preenchidos.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Docker Compose (Postgres local)
# ---------------------------------------------------------------------------
POSTGRES_USER=streamingdb_user
POSTGRES_PASSWORD=streamingdb_password
POSTGRES_DB=streamingdb
# Use apenas se o container precisar apontar para um Postgres externo:
# DOCKER_DATABASE_URL="postgresql://usuario:senha@host:5432/banco"
