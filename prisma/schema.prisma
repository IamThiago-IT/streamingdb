generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}


model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  providerId        String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, providerAccountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

model Platform {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  logo      String?
  website   String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans             Plan[]
  availability      ContentAvailability[]
  changeLog         ChangeLog[]
  priceSources      PriceSource[]
  platformCountries PlatformCountry[]
}

/// Tier canônico da plataforma (ex.: "standard", "premium", "with-ads").
/// Preço, moeda, impostos e ciclo de cobrança vivem em PlanOffer, por país.
model Plan {
  id         String   @id @default(cuid())
  platformId String
  tierKey    String?
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  platform Platform    @relation(fields: [platformId], references: [id])
  offers   PlanOffer[]

  @@unique([platformId, tierKey])
}

/// Oferta real de um plano em um país. Fonte da verdade para preço nativo.
model PlanOffer {
  id            String    @id @default(cuid())
  planId        String
  countryCode   String
  currency      String
  amount        Decimal
  billingCycle  String    @default("MONTHLY")
  billingMonths Int       @default(1)
  taxIncluded   Boolean?
  displayName   String?
  quality       String?
  ads           Boolean   @default(false)
  sourceUrl     String?
  sourceType    String    @default("MANUAL")
  status        String    @default("ACTIVE")
  lastCheckedAt DateTime?
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  plan    Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  history PriceHistory[]

  @@unique([planId, countryCode, billingCycle])
  @@index([countryCode, status])
}

model Content {
  id            String   @id @default(cuid())
  title         String
  originalTitle String?
  slug          String   @unique
  type          String
  year          Int?
  genre         String?
  poster        String?
  synopsis      String?
  rating        Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  availability ContentAvailability[]
  changeLog    ChangeLog[]
}

model ContentAvailability {
  id         String   @id @default(cuid())
  contentId  String
  platformId String
  available  Boolean  @default(true)
  addedAt    DateTime @default(now())
  removedAt  DateTime?
  updatedAt  DateTime @updatedAt

  content  Content  @relation(fields: [contentId], references: [id])
  platform Platform @relation(fields: [platformId], references: [id])

  @@unique([contentId, platformId])
}

model PriceHistory {
  id          String   @id @default(cuid())
  offerId     String
  amount      Decimal
  currency    String
  taxIncluded Boolean?
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  offer PlanOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, recordedAt])
}

/// Configuração de coleta de preço por plataforma/país.
model PriceSource {
  id          String   @id @default(cuid())
  platformId  String
  countryCode String
  url         String
  parserKey   String
  renderMode  String   @default("HTTP")
  isActive    Boolean  @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([platformId, countryCode, url])
  @@index([countryCode, isActive])
}

/// Auditoria de cada tentativa de coleta.
model ScrapeRun {
  id          String    @id @default(cuid())
  platformId  String
  countryCode String
  status      String
  httpStatus  Int?
  offersFound Int       @default(0)
  error       String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([platformId, countryCode, startedAt])
}

/// Disponibilidade comercial da plataforma no país (≠ catálogo).
model PlatformCountry {
  platformId  String
  countryCode String
  status      String   @default("UNKNOWN")
  updatedAt   DateTime @updatedAt

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@id([platformId, countryCode])
}

model ChangeLog {
  id          String   @id @default(cuid())
  type        String
  description String
  platformId  String?
  contentId   String?
  countryCode String?
  currency    String?
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())

  platform Platform? @relation(fields: [platformId], references: [id])
  content  Content?  @relation(fields: [contentId], references: [id])
}

datasource db {
  provider = "postgresql"
}
