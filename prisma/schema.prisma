generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}


model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  providerId        String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, providerAccountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

/// Serviço de streaming. Os campos de proveniência resumem a fonte principal
/// do registro; DataSource guarda todas as fontes conhecidas.
model Platform {
  id                 String    @id @default(cuid())
  name               String    @unique
  slug               String    @unique
  logo               String?
  website            String?
  color              String?
  source             String?
  sourceUrl          String?
  collectionMethod   String?
  collectedAt        DateTime?
  lastVerifiedAt     DateTime?
  verificationStatus String    @default("UNVERIFIED")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  plans             Plan[]
  availability      ContentAvailability[]
  changeLog         ChangeLog[]
  priceSources      PriceSource[]
  platformCountries PlatformCountry[]

  @@index([verificationStatus, lastVerifiedAt])
}

/// Tier canônico da plataforma (ex.: "standard", "premium", "with-ads").
/// Preço, moeda, impostos e ciclo de cobrança vivem em PlanOffer, por país.
model Plan {
  id                 String    @id @default(cuid())
  platformId         String
  tierKey            String?
  name               String
  source             String?
  sourceUrl          String?
  collectionMethod   String?
  collectedAt        DateTime?
  lastVerifiedAt     DateTime?
  verificationStatus String    @default("UNVERIFIED")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  platform Platform    @relation(fields: [platformId], references: [id])
  offers   PlanOffer[]

  @@unique([platformId, tierKey])
  @@index([verificationStatus, lastVerifiedAt])
}

/// Oferta real de um plano em um país. Fonte da verdade para preço nativo.
model PlanOffer {
  id            String    @id @default(cuid())
  planId        String
  countryCode   String
  currency      String
  amount        Decimal
  billingCycle  String    @default("MONTHLY")
  billingMonths Int       @default(1)
  taxIncluded   Boolean?
  displayName   String?
  quality       String?
  ads           Boolean   @default(false)
  sourceUrl          String?
  sourceType         String    @default("MANUAL")
  collectionMethod   String?
  status             String    @default("ACTIVE")
  verificationStatus String    @default("UNVERIFIED")
  collectedAt        DateTime?
  lastVerifiedAt     DateTime?
  lastCheckedAt      DateTime?
  lastSuccessAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  plan    Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  history PriceHistory[]

  @@unique([planId, countryCode, billingCycle])
  @@index([countryCode, status])
  @@index([verificationStatus, lastVerifiedAt])
}

model Content {
  id                 String    @id @default(cuid())
  title              String
  originalTitle      String?
  slug               String    @unique
  externalId         String?
  externalSource     String?
  type               String
  year               Int?
  genre              String?
  poster             String?
  synopsis           String?
  rating             Float?
  source             String?
  sourceUrl          String?
  collectionMethod   String?
  collectedAt        DateTime?
  lastVerifiedAt     DateTime?
  verificationStatus String    @default("UNVERIFIED")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  availability ContentAvailability[]
  changeLog    ChangeLog[]

  @@unique([externalSource, externalId])
  @@index([title, year, type])
  @@index([verificationStatus, lastVerifiedAt])
}

model ContentAvailability {
  id                 String    @id @default(cuid())
  contentId          String
  platformId         String
  countryCode        String    @default("BR")
  available          Boolean   @default(true)
  source             String?
  sourceUrl          String?
  collectionMethod   String?
  collectedAt        DateTime?
  lastVerifiedAt     DateTime?
  verificationStatus String    @default("UNVERIFIED")
  addedAt            DateTime  @default(now())
  removedAt          DateTime?
  updatedAt          DateTime  @updatedAt

  content  Content  @relation(fields: [contentId], references: [id])
  platform Platform @relation(fields: [platformId], references: [id])

  @@unique([contentId, platformId, countryCode])
  // Nome curto: o nome automático excede 63 caracteres no Postgres e seria
  // truncado, criando drift entre schema e banco.
  @@index([platformId, countryCode, available, lastVerifiedAt], map: "ContentAvailability_live_idx")
}

model PriceHistory {
  id                 String   @id @default(cuid())
  offerId            String
  amount             Decimal
  currency           String
  taxIncluded        Boolean?
  sourceType         String?
  sourceUrl          String?
  verificationStatus String   @default("UNVERIFIED")
  collectedAt        DateTime?
  recordedAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  offer PlanOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, recordedAt])
}

/// Configuração de coleta de preço por plataforma/país.
model PriceSource {
  id          String   @id @default(cuid())
  platformId  String
  countryCode String
  url         String
  parserKey   String
  renderMode  String   @default("HTTP")
  isActive    Boolean  @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([platformId, countryCode, url])
  @@index([countryCode, isActive])
}

/// Auditoria de cada tentativa de coleta. O nome ScrapeRun é histórico: hoje
/// cobre scraping, importação CSV e verificações em lote.
model ScrapeRun {
  id               String    @id @default(cuid())
  kind             String    @default("SCRAPE")
  platformId       String?
  countryCode      String?
  source           String?
  status           String
  httpStatus       Int?
  offersFound      Int       @default(0)
  recordsCreated   Int       @default(0)
  recordsUpdated   Int       @default(0)
  recordsUnchanged Int       @default(0)
  recordsFailed    Int       @default(0)
  errorCode        String?
  error            String?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?

  @@index([platformId, countryCode, startedAt])
  @@index([kind, startedAt])
  @@index([status, startedAt])
}

/// Disponibilidade comercial da plataforma no país (≠ catálogo).
model PlatformCountry {
  platformId         String
  countryCode        String
  status             String   @default("UNKNOWN")
  source             String?
  sourceUrl          String?
  collectionMethod   String?
  collectedAt        DateTime?
  lastVerifiedAt     DateTime?
  verificationStatus String   @default("UNVERIFIED")
  updatedAt          DateTime @updatedAt

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@id([platformId, countryCode])
  @@index([verificationStatus, lastVerifiedAt])
}

/// Histórico de mudanças relevante. `entityType`/`entityId` identificam
/// qualquer entidade; platformId/contentId continuam para compatibilidade.
model ChangeLog {
  id          String   @id @default(cuid())
  type        String
  entityType  String?
  entityId    String?
  field       String?
  description String
  platformId  String?
  contentId   String?
  countryCode String?
  currency    String?
  oldValue    String?
  newValue    String?
  source      String?
  process     String?
  actor       String?
  metadata    String?
  createdAt   DateTime @default(now())

  platform Platform? @relation(fields: [platformId], references: [id])
  content  Content?  @relation(fields: [contentId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([type, createdAt])
}

/// Uma fonte conhecida para um registro. Permite múltiplas origens sem
/// sobrescrever a proveniência anterior. Relação polimórfica por
/// (entityType, entityId); não há FK para acomodar todas as entidades.
model DataSource {
  id                 String    @id @default(cuid())
  dedupeKey          String    @unique
  entityType         String
  entityId           String
  source             String
  sourceUrl          String?
  collectionMethod   String
  collectedAt        DateTime
  lastVerifiedAt     DateTime?
  verificationStatus String    @default("UNVERIFIED")
  isPrimary          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([entityType, entityId])
  @@index([verificationStatus, lastVerifiedAt])
}

/// Problema detectado (duplicidade, inconsistência, validação, atraso).
/// Nunca apaga o registro original; serve para revisão humana.
model DataQualityIssue {
  id             String    @id @default(cuid())
  fingerprint    String    @unique
  entityType     String
  entityIds      String
  rule           String
  severity       String    @default("WARNING")
  message        String
  details        String?
  status         String    @default("OPEN")
  detectedAt     DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  resolvedAt     DateTime?
  resolutionNote String?

  @@index([status, severity])
  @@index([rule])
  @@index([entityType, lastSeenAt])
  @@index([lastSeenAt])
}

datasource db {
  provider = "postgresql"
}
