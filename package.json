{
  "name": "streamingdb",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "postinstall": "prisma generate",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset --force",
    "seed:offers": "npx tsx scripts/import-offers.ts",
    "validate:offers": "npx tsx scripts/validate-offers.ts",
    "scrape": "npx tsx scripts/scraper.ts",
    "monitor": "npx tsx scripts/monitor.ts",
    "seed:content": "npx tsx scripts/seed-content.ts",
    "quality:report": "npx tsx scripts/quality-report.ts",
    "quality:scan": "npx tsx scripts/quality-report.ts --scan",
    "quality:refresh-stale": "npx tsx scripts/refresh-stale.ts",
    "test:setup": "npx tsx scripts/prepare-test-db.ts",
    "pretest": "npx tsx scripts/prepare-test-db.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "better-sqlite3",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.26",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.6.26",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "next": "16.2.2",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
